# Belle MCP Server — Environment Configuration
# Copy to .env and fill in values

# --- Supabase connection (required) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Optional: rate limit + audit ---
MCP_RATE_LIMIT_PER_MIN=60
MCP_AUDIT_LOG_ENABLED=true

# --- Optional: transport (defaults to stdio) ---
# MCP_TRANSPORT=stdio    # for Claude Desktop, Cursor, etc.
# MCP_TRANSPORT=http     # for hosted deployment (uses PORT)
# PORT=3939

# --- Auth for HTTP transport only ---
# MCP_HTTP_TOKEN=random-shared-secret
